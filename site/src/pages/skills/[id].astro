---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Install from '../../components/Install.astro';
import CommandBar from '../../components/CommandBar.astro';
import { CATEGORIES, BLURBS, categoryOf, orderedSlugs, triggersFrom, bundleOf, rawSkillFile } from '../../lib/catalog.js';
import { renderSkillBody, outlineOf } from '../../lib/markdown.js';
import { SITE_NAME, SITE_TAGLINE, SITE_FULL_NAME, GITHUB_URL, REPO_SLUG, CONTRIBUTOR, href, abs, metaDescription } from '../../lib/site.js';

export async function getStaticPaths() {
  const entries = await getCollection('skills');
  const order = orderedSlugs();
  const sorted = [...entries].sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
  return sorted.map((entry, i) => ({
    params: { id: entry.id },
    props: {
      entry,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const slug = entry.id;
const data = entry.data;

// Render the SKILL.md body verbatim, minus the H1 (the page supplies its own).
const body = (entry.body ?? '').replace(/^#\s+.+\n/, '');
const html = renderSkillBody(body);
const outline = outlineOf(body);
const bundle = bundleOf(slug);
const cat = categoryOf(slug);
const blurb = BLURBS[slug] ?? '';
const triggers = triggersFrom(data.description, 5);
const roles = (data.metadata?.role ?? '').split('|').map((s) => s.trim()).filter(Boolean);
const cadence = data.metadata?.cadence;
const version = data.metadata?.version;
const repoDir = `${GITHUB_URL}/tree/main/skills/${slug}`;
const rawUrl = `${GITHUB_URL}/blob/main/skills/${slug}/SKILL.md`;

// The slug is the identifier users type, so it leads; the humanised form gives
// search engines and tab strips real words to match on.
const humanName = slug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
// For a long slug the humanised form only repeats it, so drop it rather than
// let the title overrun the SERP limit.
const titleWithName = `${slug} — ${humanName} skill ${SITE_TAGLINE}`;
const title =
  titleWithName.length <= 65
    ? titleWithName
    : `${slug} — customer success skill ${SITE_TAGLINE}`;
const description = metaDescription(blurb, `An open-source customer success skill ${SITE_TAGLINE}, MIT-licensed.`);

// Byte length, not UTF-16 code units — the file is full of em dashes and ·.
const bytes = Buffer.byteLength(rawSkillFile(slug), 'utf8');

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE_FULL_NAME, item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Skills', item: abs('/skills/') },
      ...(cat
        ? [{ '@type': 'ListItem', position: 3, name: cat.label, item: abs(`/skills/#${cat.id}`) }]
        : []),
      { '@type': 'ListItem', position: cat ? 4 : 3, name: slug },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: slug,
    description: blurb || data.description.slice(0, 300),
    url: abs(`/skills/${slug}/`),
    codeRepository: repoDir,
    programmingLanguage: 'Markdown',
    runtimePlatform: 'Agent Skills',
    license: 'https://opensource.org/licenses/MIT',
    ...(version ? { version } : {}),
    isPartOf: { '@type': 'SoftwareSourceCode', name: SITE_FULL_NAME, url: abs('/') },
    contributor: { '@type': 'Organization', name: CONTRIBUTOR.name, url: CONTRIBUTOR.url },
  },
];
---

<Base
  title={title}
  ogTitle={`${slug} — a customer success skill ${SITE_TAGLINE}`}
  description={description}
  jsonld={jsonld}
  mdTwin={href(`/skills/${slug}.md`)}
>
  <div class="wrap">
    <header class="skillhead">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={href('/')}>Home</a>
        <span aria-hidden="true">/</span>
        <a href={href('/skills/')}>Skills</a>
        <span aria-hidden="true">/</span>
        {cat && <a href={href(`/skills/#${cat.id}`)}>{cat.label}</a>}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{slug}</span>
      </nav>

      <h1>{slug}</h1>
      {blurb && <p class="skillhead__lede">{blurb}</p>}

      <div class="tags">
        {version && <span class="tag tag--strong">v{version}</span>}
        {roles.map((r) => <span class="tag">{r}</span>)}
        {cadence && <span class="tag">{cadence}</span>}
        <span class="tag">MIT</span>
        <a class="tag" href={rawUrl} rel="noopener">SKILL.md ↗</a>
      </div>
    </header>

    <div class="skillbody">
      <div>
        {triggers.length > 0 && (
          <section style="margin-bottom: 2.5rem">
            <p class="eyebrow">When it fires</p>
            <p class="muted" style="margin-top: -.4rem; margin-bottom: 1rem; font-size: .9375rem">
              Skills match on what you actually type, not on a command name. Phrases the skill
              declares, verbatim from its <code>description</code>:
            </p>
            <div class="tags">
              {triggers.map((t) => <span class="tag">“{t}”</span>)}
            </div>
          </section>
        )}

        <section style="margin-bottom: 2.5rem">
          <p class="eyebrow">What ships in the folder</p>
          <div class="bundle">
            <div class="bundle__row">
              <span class="bundle__k">SKILL.md</span>
              <span class="bundle__v"><a href={rawUrl} rel="noopener">{(bytes / 1024).toFixed(1)} KB — the runbook the agent reads</a></span>
            </div>
            {['references', 'scripts', 'assets', 'evals'].map((kind) =>
              bundle[kind].length > 0 ? (
                <div class="bundle__row">
                  <span class="bundle__k">{kind}</span>
                  <span class="bundle__v">
                    {bundle[kind].map((f) => (
                      <a href={`${GITHUB_URL}/blob/main/skills/${slug}/${kind}/${f}`} rel="noopener">{f}</a>
                    ))}
                  </span>
                </div>
              ) : null
            )}
          </div>
          <p class="muted mono-sm">Read at runtime, on demand — the agent loads only what the task needs.</p>
        </section>

        <section style="margin-bottom: 2.5rem">
          <p class="eyebrow">Install just this skill</p>
          <CommandBar
            command={`npx skills add ${REPO_SLUG} --skill ${slug}`}
            label={slug}
            note={`Or take the whole library: <code>npx skills add ${REPO_SLUG}</code> — <a href="${href('/#install')}">all install options</a>.`}
          />
        </section>

        <hr style="margin: 2.5rem 0 2.75rem" />

        <article class="prose" set:html={html} />

        <nav class="pager" aria-label="More skills">
          {prev ? (
            <a href={href(`/skills/${prev.id}/`)}>
              <span class="pager__k">← Previous</span>
              <span class="pager__v">{prev.id}</span>
            </a>
          ) : (
            <a href={href('/skills/')}><span class="pager__k">← Index</span><span class="pager__v">All skills</span></a>
          )}
          {next ? (
            <a href={href(`/skills/${next.id}/`)}>
              <span class="pager__k">Next →</span>
              <span class="pager__v">{next.id}</span>
            </a>
          ) : (
            <a href={href('/skills/')}><span class="pager__k">Index →</span><span class="pager__v">All skills</span></a>
          )}
        </nav>
      </div>

      <aside class="toc">
        <h2>On this page</h2>
        <ul>
          {outline.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}
        </ul>

        {cat && (
          <>
            <h2>More in {cat.label}</h2>
            <ul>
              {cat.skills
                .filter((s) => s !== slug)
                .map((s) => <li><a href={href(`/skills/${s}/`)}>{s}</a></li>)}
              {cat.skills.length === 1 && <li><a href={href('/skills/')}>All {CATEGORIES.length} groups</a></li>}
            </ul>
          </>
        )}

        <h2>Source</h2>
        <ul>
          <li><a href={repoDir} rel="noopener">Skill folder ↗</a></li>
          <li><a href={rawUrl} rel="noopener">SKILL.md ↗</a></li>
          <li><a href={href(`/skills/${slug}.md`)}>Markdown twin</a></li>
        </ul>
      </aside>
    </div>
  </div>
</Base>
