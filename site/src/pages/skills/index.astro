---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SkillCard from '../../components/SkillCard.astro';
import { CATEGORIES, BLURBS, assertCatalogComplete } from '../../lib/catalog.js';
import { SITE_NAME, SITE_TAGLINE, SITE_FULL_NAME, href, abs, metaDescription } from '../../lib/site.js';

const entries = await getCollection('skills');
const byId = new Map(entries.map((e) => [e.id, e]));
assertCatalogComplete(entries.map((e) => e.id));
const skillCount = entries.length;

const title = `All ${skillCount} skills — ${SITE_FULL_NAME}`;
const description = metaDescription(
  `Every one of the ${skillCount} customer success skills ${SITE_TAGLINE}: churn risk, save plays, renewals, QBRs, expansion, onboarding, health scores and CS ops.`
);

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE_FULL_NAME, item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Skills' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `The ${skillCount} customer success skills ${SITE_TAGLINE}`,
    numberOfItems: skillCount,
    itemListElement: CATEGORIES.flatMap((c) => c.skills).map((slug, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: slug,
      description: BLURBS[slug],
      url: abs(`/skills/${slug}/`),
    })),
  },
];
---

<Base title={title} description={description} jsonld={jsonld}>
  <div class="wrap">
    <header class="skillhead">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={href('/')}>Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Skills</span>
      </nav>
      <h1 style="font-family: var(--serif); font-weight: 500">All {skillCount} skills</h1>
      <p class="skillhead__lede">
        Grouped by the work they do. Each is a self-contained folder — <code>SKILL.md</code> plus
        its references, assets, scripts and evals — so you can take the whole library or just the
        two you want.
      </p>
      <div class="tags">
        {CATEGORIES.map((c) => (
          <a class="tag" href={`#${c.id}`}>{c.label} · {c.skills.length}</a>
        ))}
      </div>
    </header>
  </div>

  <section class="section">
    <div class="wrap">
      {CATEGORIES.map((cat) => (
        <div class="cat" id={cat.id}>
          <div class="cat__head">
            <h2>{cat.label}</h2>
            <span class="cat__count">{String(cat.skills.length).padStart(2, '0')}</span>
            <span class="cat__note">{cat.note}</span>
          </div>
          <div class="cards">
            {cat.skills.map((slug) => (
              <SkillCard
                slug={slug}
                blurb={BLURBS[slug]}
                role={byId.get(slug)?.data?.metadata?.role}
                version={byId.get(slug)?.data?.metadata?.version}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
